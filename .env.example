# Generate a real token with: python scripts/bootstrap.py
CODEPET_TOKEN=
CODEPET_OLLAMA_URL=http://127.0.0.1:11434
# ollama (offline) ou codex (CLI autenticado, requer internet)
# ollama, codex ou hybrid (DeepHat local + segunda opinião do Codex CLI)
CODEPET_PROVIDER=ollama
# Opcional quando CODEPET_PROVIDER=codex. Vazio usa o padrão do CLI.
CODEPET_CODEX_MODEL=
# Empty means discover exactly one installed model whose name contains DeepHat.
CODEPET_MODEL=
CODEPET_PROJECTS={"default":"/absolute/path/to/your/project"}
CODEPET_DATABASE=.codepet/memory.db
CODEPET_RETENTION=true
CODEPET_PROACTIVE=false
CODEPET_CONTEXT_CHARS=12000
# Opcional: diretório de skills SKILL.md criadas pelo usuário.
# CODEPET_SKILLS_DIR=/home/usuario/.config/codepet-ai/skills
CODEPET_NUM_CTX=4096
CODEPET_NUM_PREDICT=768
# Captura explícita de tela via grim; desligada por padrão por privacidade.
CODEPET_SCREEN_CAPTURE=false
CODEPET_SCREEN_CAPTURE_MAX_BYTES=4000000
# Bubblewrap bloqueia rede e limita o processo de testes; use none conscientemente.
CODEPET_TEST_SANDBOX=bubblewrap
