{
  "name": "codepet-ai",
  "displayName": "CodePet AI",
  "description": "Local, consent-based programming tutor context bridge",
  "version": "0.1.0",
  "publisher": "codepet-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codepet.configureToken",
        "title": "CodePet: Configurar token local"
      },
      {
        "command": "codepet.explain",
        "title": "CodePet: Explicar sele\u00e7\u00e3o"
      },
      {
        "command": "codepet.diagnose",
        "title": "CodePet: Analisar diagn\u00f3stico"
      },
      {
        "command": "codepet.nextStep",
        "title": "CodePet: Encontrar pr\u00f3ximo passo"
      },
      {
        "command": "codepet.exercise",
        "title": "CodePet: Criar exerc\u00edcio"
      },
      {
        "command": "codepet.progress",
        "title": "CodePet: Ver progresso e métricas"
      },
      {
        "command": "codepet.saveResult",
        "title": "CodePet: Guardar resultado na memória"
      },
      {
        "command": "codepet.pause",
        "title": "CodePet: Pausar observa\u00e7\u00e3o"
      },
      {
        "command": "codepet.resume",
        "title": "CodePet: Retomar observa\u00e7\u00e3o"
      },
      {
        "command": "codepet.cancel",
        "title": "CodePet: Cancelar resposta"
      }
    ],
    "configuration": {
      "title": "CodePet AI",
      "properties": {
        "codepet.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Permitir eventos autom\u00e1ticos do editor para o backend local."
        },
        "codepet.shareSelection": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Incluir sele\u00e7\u00e3o em eventos autom\u00e1ticos."
        },
        "codepet.shareDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Incluir diagn\u00f3sticos em eventos autom\u00e1ticos."
        },
        "codepet.proactive": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Exibir sugest\u00f5es de diagn\u00f3sticos repetidos."
        },
        "codepet.project": {
          "type": "string",
          "default": "default",
          "scope": "machine",
          "description": "ID do projeto autorizado no backend. A raiz deve corresponder ao workspace."
        },
        "codepet.mode": {
          "type": "string",
          "enum": [
            "tutor",
            "copilot",
            "silent",
            "focus"
          ],
          "default": "tutor",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.cjs",
    "package": "npm run compile && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.7.0"
  }
}
